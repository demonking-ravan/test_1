---
interface Props {
    description: string;
    title: string;
    image: string;
    url: string;
    tags?: string[];
}

const { description, title, image, url, tags = [] } = Astro.props;
---

<article
    class="group cursor-pointer rounder-corners card-shadow overflow-hidden"
>
    <a href={url} class="block">
        <div class="aspect-5/4 overflow-hidden mb-8">
            <img
                src={image}
                alt={title}
                class="w-full h-full object-cover transition-all duration-1000 scale-110 hover:scale-100"
            />
        </div>
        <div class="px-6 pb-8">
            <h2
                class="footer-heading tracking-wider text-black group-hover:underline decoration-1 underline-offset-4 mb-4"
            >
                {title}
            </h2>
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-4">
                        {tags.map((tag) => (
                            <span class="font-aventa text-[.8rem] uppercase tracking-[0.2em] text-gray-500 border border-gray-200 px-3 py-1 rounded-full">
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }

            <!-- <p class="font-aventa text-[1rem] tracking-wider text-gray-800">
                {description}
            </p> -->
        </div>
    </a>
</article>
