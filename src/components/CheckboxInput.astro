---
export interface Props {
  id: string;
  name: string;
  value: string;
  label: string;
  checked?: boolean;
  className?: string;
}

const { id, name, value, label, checked = false, className = "" } = Astro.props;
---

<label for={id} class={`cursor-pointer grow ${className}`}>
  <input
    type="checkbox"
    id={id}
    name={name}
    value={value}
    {checked}
    class="pill-checkbox sr-only"
  />
  <div
    class="px-4 py-3 rounded-lg border border-gray-300 text-center text-xl lg:text-2xl hover:border-gray-800 transition-all peer-checked:bg-theme-dark peer-checked:text-white"
  >
    {label}
  </div>
</label>
