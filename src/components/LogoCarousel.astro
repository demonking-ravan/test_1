---
const logos = [
    { name: "Vogue", src: "/logos/vogue.svg" },
    { name: "Wedding Bazaar", src: "/logos/WeddingBazaar.svg" },
    { name: "EventFAQS", src: "/logos/eventfaqs.png" },
    { name: "WeddingSutra", src: "/logos/wedding-sutra.png" },
    { name: "WedMeGood", src: "/logos/wedme-good.png" },
];

// Duplicate the logos array to create a seamless loop
const displayLogos = [...logos, ...logos, ...logos, ...logos];
---

<section class="py-16 bg-white border-y border-gray-100 overflow-hidden">
    <div class="max-w-560 mx-auto px-10 mb-6">
        <h2
            class="font-aventa text-[1rem] uppercase tracking-[0.4em] text-gray-400 text-center font-bold"
        >
            As Featured In
        </h2>
    </div>

    <div class="relative flex overflow-x-hidden">
        <div
            class="animate-marquee flex items-center gap-32 whitespace-nowrap py-4"
        >
            {
                displayLogos.map((logo) => (
                    <div class="flex items-center justify-center min-w-[20rem]">
                        <img
                            src={logo.src}
                            alt={logo.name}
                            class="h-12 w-auto grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500 cursor-pointer object-contain"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
        display: flex;
        width: fit-content;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }
</style>
