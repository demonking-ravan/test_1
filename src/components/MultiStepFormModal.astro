</div>

<script>
  // TypeScript types for the form
  interface FormData {
    brideName: string;
    groomName: string;
    yourName: string;
    phone: string;
    email: string;
    alternatePhone: string;
    weddingDateFrom: string;
    weddingDateTo: string;
    city: string;
    venueFinalized: "yes" | "no" | "";
    venueName: string;
    estimatedGuests: number;
    roomsNeeded: number;
    services: string[];
    budget: string;
    notes: string;
  }

  type FormStep = 0 | 1 | 2 | 3;
  type ModalState = "open" | "closed";

  let currentTab: FormStep = 0;
  const tabs: string[] = ["step1", "step2", "step3", "step4"];
  const titles: string[] = [
    "Let's start with names",
    "How can we reach you?",
    "When & Where?",
    "Scope & Budget",
  ];

  // --- Modal Logic ---
  // function openModal(): void {
  //     const modal = document.getElementById('inquiryModal') as HTMLElement;
  //     const backdrop = document.getElementById('modalBackdrop') as HTMLElement;
  //     const panel = document.getElementById('modalPanel') as HTMLElement;

  //     modal.classList.remove('hidden');
  //     // Small delay for CSS transitions
  //     setTimeout(() => {
  //         backdrop.classList.remove('opacity-0');
  //         panel.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
  //         panel.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
  //     }, 10);

  //     showTab(0); // Reset to start
  // }

  // function closeModal(): void {
  //     const modal = document.getElementById('inquiryModal') as HTMLElement;
  //     const backdrop = document.getElementById('modalBackdrop') as HTMLElement;
  //     const panel = document.getElementById('modalPanel') as HTMLElement;

  //     backdrop.classList.add('opacity-0');
  //     panel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
  //     panel.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');

  //     setTimeout(() => {
  //         modal.classList.add('hidden');
  //     }, 300); // Wait for transition
  // }

  // --- Wizard Logic ---
  function showTab(n: FormStep): void {
    // Hide all tabs
    tabs.forEach((id) => document.getElementById(id)?.classList.add("hidden"));
    document.getElementById("stepSuccess")?.classList.add("hidden");

    // Show current
    document.getElementById(tabs[n])?.classList.remove("hidden");

    // Update Header & Progress
    const stepTitle = document.getElementById("stepTitle") as HTMLElement;
    const stepDesc = document.getElementById("stepDesc") as HTMLElement;
    const progressBar = document.getElementById("progressBar") as HTMLElement;

    stepTitle.innerText = titles[n];
    stepDesc.innerText = `Step ${n + 1} of ${tabs.length}`;
    progressBar.style.width = `${((n + 1) / tabs.length) * 100}%`;

    // Update Buttons
    const prevBtn = document.getElementById("prevBtn") as HTMLButtonElement;
    const nextBtn = document.getElementById("nextBtn") as HTMLButtonElement;
    const nextBtnText = document.querySelector(
      ".nextbtn__text"
    ) as HTMLDivElement;

    if (n == 0) {
      prevBtn.classList.add("hidden");
    } else {
      prevBtn.classList.remove("hidden");
    }

    if (n == tabs.length - 1) {
      nextBtnText.innerHTML = "Submit Request";
    } else {
      nextBtnText.innerHTML = "Next Step";
    }

    // Show footer (might be hidden on success)
    document.getElementById("formFooter")?.classList.remove("hidden");
  }

  function nextPrev(n: number): boolean {
    const currentTabEl = document.getElementById(
      tabs[currentTab]
    ) as HTMLElement;

    // Validate if moving forward
    if (n == 1 && !validateForm(currentTabEl)) return false;

    // Hide current
    currentTabEl.classList.add("hidden");

    currentTab = (currentTab + n) as FormStep;

    if (currentTab >= tabs.length) {
      submitForm();
      return false;
    }

    showTab(currentTab);
    return true;
  }

  function validateForm(tabElement: HTMLElement): boolean {
    const inputs = tabElement.querySelectorAll<HTMLInputElement>(
      "input[required], select[required]"
    );
    let valid = true;
    inputs.forEach((input) => {
      if (!input.value.trim()) {
        input.classList.add("error");
        valid = false;
      } else {
        input.classList.remove("error");
      }
    });
    return valid;
  }

  function toggleVenue(isFinal: boolean): void {
    const vYes = document.getElementById("venueYes") as HTMLElement;
    const vNo = document.getElementById("venueNo") as HTMLElement;
    if (isFinal) {
      vYes.classList.remove("hidden");
      vNo.classList.add("hidden");
    } else {
      vYes.classList.add("hidden");
      vNo.classList.remove("hidden");
    }
  }

  function submitForm(): void {
    // Logic for determining success message
    const services = document.querySelectorAll<HTMLInputElement>(
      'input[name="services"]:checked'
    );
    let isPlanning = false;
    services.forEach((s) => {
      if (s.value === "wedding planning") isPlanning = true;
    });

    const msgEl = document.getElementById("successMessage") as HTMLElement;
    if (isPlanning) {
      msgEl.innerText =
        "Thank you for your inquiry. Our team will connect with you shortly to share our wedding planning profile and a curated proposal.";
    } else {
      msgEl.innerText =
        "We would love to schedule a brief call to understand your vision in depth and explore how we can bring it to life. A member of our team will reach out shortly.";
    }

    let data = collectFormData();
    console.log("--- /n", data);

    fetch("https://formsubmit.co/ajax/weddings@mapsor.com", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: JSON.stringify(data),
    })
      .then((response) => response.json())
      .then((data) => console.log(data))
      .catch((error) => console.log(error));

    // Hide form parts, show success
    tabs.forEach((id) => document.getElementById(id)?.classList.add("hidden"));
    document.getElementById("formFooter")?.classList.add("hidden");
    const stepTitle = document.getElementById("stepTitle") as HTMLElement;
    const stepDesc = document.getElementById("stepDesc") as HTMLElement;
    const progressBar = document.getElementById("progressBar") as HTMLElement;

    stepTitle.innerText = "All set!";
    stepDesc.classList.add("hidden");
    progressBar.style.width = "100%";

    document.getElementById("stepSuccess")?.classList.remove("hidden");
  }

  const services = document.querySelectorAll<HTMLInputElement>(
    'input[name="services"]'
  );
  const bud1 = document.getElementById("budget") as HTMLDivElement;

  services.forEach((s) => {
    s.addEventListener("change", function () {
      if (s.value === "wedding planning" && !this.checked) {
        bud1.classList.add("show-budg1");
        bud1.classList.remove("show-budg2");
      }
      if (s.value === "design & decor" && this.checked) {
        bud1.classList.add("show-budg2");
        bud1.classList.remove("show-budg1");
      }
      if (s.value === "turnkey experience" && this.checked) {
        bud1.classList.add("show-budg2");
        bud1.classList.remove("show-budg1");
      }
      // if (s.value === "design & decor") {
      //   sDeco = this.checked;
      // }
      // if (s.value === "turnkey experience") {
      //   sTurn = this.checked;
      // }
    });
  });

  // Optional: Form data collection function for Astro
  function collectFormData(): FormData {
    return {
      brideName:
        (document.getElementById("brideName") as HTMLInputElement)?.value || "",
      groomName:
        (document.getElementById("groomName") as HTMLInputElement)?.value || "",
      yourName:
        (document.getElementById("contactPerson") as HTMLInputElement)?.value ||
        "",
      phone:
        (document.querySelector("#step2 #phone") as HTMLInputElement)?.value ||
        "",
      email:
        (document.querySelector("#step2 #email") as HTMLInputElement)?.value ||
        "",
      alternatePhone:
        (document.querySelector("#step2 #alternatePhone") as HTMLInputElement)
          ?.value || "",
      weddingDateFrom:
        (document.querySelector("#step3 #weddingDateFrom") as HTMLInputElement)
          ?.value || "",
      weddingDateTo:
        (document.querySelector("#step3 #weddingDateTo") as HTMLInputElement)
          ?.value || "",
      city:
        (document.querySelector("#step3 #city") as HTMLInputElement)?.value ||
        "",
      venueFinalized:
        ((
          document.querySelector(
            'input[name="venue_finalized"]:checked'
          ) as HTMLInputElement
        )?.value as "yes" | "no") || "",
      venueName:
        (document.querySelector("#venueYes #venueName") as HTMLInputElement)
          ?.value || "",
      estimatedGuests:
        parseInt(
          (
            document.querySelector(
              "#venueNo #estimatedGuests"
            ) as HTMLInputElement
          )?.value
        ) || 0,
      roomsNeeded:
        parseInt(
          (document.querySelector("#venueNo #roomsNeeded") as HTMLInputElement)
            ?.value
        ) || 0,
      services: Array.from(
        document.querySelectorAll<HTMLInputElement>(
          'input[name="services"]:checked'
        )
      ).map((s) => s.value),
      budget:
        (
          document.querySelector(
            'input[name="budget1"]:checked + div'
          ) as HTMLElement
        )?.innerText ||
        (
          document.querySelector(
            'input[name="budget2"]:checked + div'
          ) as HTMLElement
        )?.innerText,
      notes:
        (document.querySelector("#step4 textarea") as HTMLTextAreaElement)
          ?.value || "",
    };
  }

  // Make functions available globally for Astro
  // window.openModal = openModal;
  // window.closeModal = closeModal;
  window.nextPrev = nextPrev;
  window.toggleVenue = toggleVenue;
  window.submitForm = submitForm;
  window.collectFormData = collectFormData;
</script>
