---
export interface Props {
  id: string;
  name: string;
  value: string;
  label: string;
  checked?: boolean;
  onchange?: string;
  required?: boolean;
  className?: string;
}

const {
  id,
  name,
  value,
  label,
  checked = false,
  onchange = "",
  required = false,
  className = "",
} = Astro.props;
---

<label for={id} class={`cursor-pointer ${className}`}>
  <input
    type="radio"
    id={id}
    name={name}
    value={value}
    {checked}
    {required}
    class="peer sr-only"
    {onchange}
  />
  <div
    class="px-5 py-2 rounded-full border border-gray-400 text-xl lg:text-2xl text-gray-600 peer-checked:bg-theme-dark peer-checked:text-white peer-checked:border-theme-dark transition-all text-center"
  >
    {label}
  </div>
</label>
