---
// Define the services based on company data
const services = [
    {
        title: "Choreography Agency",
        desc: "We select the right choreographers and manage rehearsal timelines across different functions, ensuring every performance leaves your guests truly captivated.",
        extra: "Expressions of joy brought to life.",
        image: "/services/choreography.jpeg",
    },
    {
        title: "Destination Management",
        desc: "International & National expertise tailored to your unique story.",
        extra: "No more coordination stress—just seamless planning!",
        image: "/services/destination-management.jpg",
    },
    {
        title: "Decor Designing",
        desc: "Transforming venues into visually enchanting thematic experiences.",
        extra: "Immersive floral and light installations.",
        image: "/services/decor-design.jpg",
    },
    {
        title: "Entertainment",
        desc: "Captivating array of activities to engage and wow your guests.",
        extra: "Celebrity acts & bespoke performances.",
        image: "/services/entertainment.jpg",
    },
    {
        title: "Food Designing & Catering",
        desc: "From assisting in partner selection to designing live counters and innovative presentations, we ensure every dish complements your wedding theme.",
        extra: "We treat food as a sensory experience.",
        image: "/services/food-designing-catering.jpg",
    },
    {
        title: "Hotel Coordination & Management",
        desc: "We guide you toward the perfect property—from heritage palaces to boutique resorts—managing contracts, room blocks, and hospitality desks for a seamless stay.",
        extra: "The right hotel is the heart of your wedding experience.",
        image: "/services/hotel-coordination-management.jpeg",
    },
    {
        title: "Logistics Coordination & Management",
        desc: "We orchestrate all transportation—airport transfers, venue shuttles, and VIP logistics—ensuring every guest's journey is smooth and on time.",
        extra: "",
        image: "/services/logistics-coordination-management.jpeg",
    },
    {
        title: "Makeup Artist Coordination",
        desc: "We recommend the most suitable artists for your style, organizing trials and managing schedules so you feel radiant and confident.",
        extra: "Your bridal beauty journey, carefully curated.",
        image: "/services/makeup-artist-coordination.jpg",
    },
    {
        title: "Room Hamper & Amenities",
        desc: "We curate bespoke welcome hampers and coordinate in-room amenities that offer your guests a heartfelt, personalized welcome.",
        extra: "Setting the tone with thoughtful first impressions.",
        image: "/services/room-hamper-amenities.jpg",
    },
    {
        title: "Photo & Video Coordination",
        desc: "We connect you with the perfect creative professionals, aligning on shot lists and mood boards to ensure your memories are documented with finesse.",
        extra: "Your love story captured with artistry.",
        image: "/services/photo-video-coordination.jpg",
    },
    {
        title: "RSVP & Guest Management",
        desc: "We believe in a guest-centric approach.",
        extra: "",
        image: "/services/rsvp-guest-management.png",
    },
    {
        title: "Hospitality & Guest Management",
        desc: "Timely arrival and seamless transitions for a flawless experience.",
        extra: "Bespoke room hampers & personalized care.",
        image: "https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&q=80&w=800",
    },
];
---

<section
    class="w-full flex flex-col justify-center px-6 lg:px-24 py-24 md:py-48 bg-[#101820] relative overflow-hidden"
    id="services-slider-section"
>
    <!-- Background accents -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-100/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-[120px]"></div>
    
    <div class="max-w-[1440px] mx-auto w-full relative z-10">
        <div class="mb-20 space-y-6">
            <p class="font-orlean text-[1rem] uppercase tracking-[0.3rem] text-primary-100">
                Our Services
            </p>
            <h2 class="sub-heading text-white">
                Extraordinary <span class="text-white/20">Wedding Services</span>
            </h2>
        </div>

        <div class="swiper-container overflow-visible w-full">
            <div class="swiper-wrapper">
                {
                    services.map((s) => (
                        <div class="swiper-slide !h-[500px]">
                            <div class="h-full rounded-[3rem] overflow-hidden relative group border border-white/10 bg-white/5 backdrop-blur-sm transition-all duration-700 hover:border-primary-100/50">
                                <!-- Background Image with Overlay -->
                                <div class="absolute inset-0 overflow-hidden">
                                    <img
                                        src={s.image}
                                        class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-60 transition-all duration-1000 scale-105 group-hover:scale-100"
                                        alt={s.title}
                                    />
                                    <div class="absolute inset-0 bg-linear-to-t from-[#101820] via-[#101820]/80 to-transparent" />
                                </div>

                                <div class="relative z-10 h-full p-12 flex flex-col justify-between">
                                    <div class="space-y-4">
                                        <div class="w-12 h-px bg-primary-100/50"></div>
                                        <p class="font-aventa text-sm uppercase tracking-[0.2em] text-primary-100 font-semibold">
                                            {s.extra}
                                        </p>
                                    </div>
                                    
                                    <div class="space-y-6">
                                        <h3 class="font-orlean text-3xl md:text-4xl text-white uppercase leading-tight group-hover:text-primary-100 transition-colors">
                                            {s.title}
                                        </h3>
                                        <p class="font-aventa text-base text-gray-400 leading-relaxed max-w-[90%]">
                                            {s.desc}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="swiper-pagination !static mt-20"></div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<style is:global>
    .swiper-pagination-bullet {
        width: 10px !important;
        height: 10px !important;
        background: rgba(255, 255, 255, 0.2) !important;
        opacity: 1 !important;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
        border-radius: 99px !important;
        margin: 0 8px !important;
    }
    .swiper-pagination-bullet-active {
        background: #f3829c !important; /* primary-100 from global.css */
        width: 35px !important;
    }
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";

    const swiper = new Swiper(".swiper-container", {
        modules: [Autoplay, Pagination],
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        autoplay: {
            delay: 4000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        breakpoints: {
            640: {
                slidesPerView: 2,
                spaceBetween: 30,
            },
            1024: {
                slidesPerView: 3,
                spaceBetween: 40,
            },
        },
    });
</script>
