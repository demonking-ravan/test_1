---
import { servicesData } from "../data/servicesData";
---

<section
    class="w-full flex flex-col justify-center px-6 lg:px-24 py-16 md:py-24 relative overflow-hidden bg-brand-grey"
    id="services-slider-section"
>
    <!-- Background accents -->
    <!-- <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-100/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-[120px]"></div> -->
    
    <div class="max-w-360 mx-auto w-full relative z-10">
        <div class="mb-20 space-y-6">
            <p class="sec-tagline ">
                Our Services
            </p>
            <h2 class="sub-heading text-black">
                Extraordinary <span class="text-brand-beige">Wedding Services</span>
            </h2>
        </div>

        <div class="swiper-container overflow-visible w-full">
            <div class="swiper-wrapper">
                {
                    servicesData.map((s, index) => (
                        <div class="swiper-slide h-125!">
                            <a href={`/services#service-${index}`} class="block h-full rounded-[3rem] overflow-hidden relative group border border-white/10 bg-white/5 backdrop-blur-sm card-shadow hover:border-brand-beige">
                                <!-- Background Image with Overlay -->
                                <div class="absolute inset-0 overflow-hidden">
                                    <img
                                        src={s.image}
                                        class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-80 transition-all duration-1000 scale-105 group-hover:scale-100"
                                        alt={s.title}
                                    />
                                    <div class="absolute inset-0 bg-linear-to-t from-[#101820] via-[#101820]/80 to-transparent" />
                                </div>

                                <div class="relative z-10 h-full p-12 flex flex-col justify-between">
                                    <div class="self-end text-white/50 group-hover:text-brand-beige transition-colors duration-500">
                                        <i class="fa-solid fa-arrow-right text-2xl -rotate-45 group-hover:translate-x-2 group-hover:-translate-y-2 transition-transform duration-500"></i>
                                    </div>
                                    
                                    <div class="space-y-6">
                                        <h3 class="font-orlean text-3xl md:text-3xl text-white uppercase leading-tight group-hover:text-brand-beige transition-colors">
                                            {s.title} {s.subtitle}
                                        </h3>
                                        <p class="font-aventa text-base text-gray-400 leading-relaxed max-w-[90%] line-clamp-3">
                                            {s.description[0]}
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    ))
                }
            </div>

            <div class="swiper-pagination !static mt-20"></div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<style is:global>
    .swiper-pagination-bullet {
        width: 10px !important;
        height: 10px !important;
        background: rgba(131, 131, 131, 0.5) !important;
        opacity: 1 !important;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
        border-radius: 99px !important;
        margin: 0 8px !important;
    }
    .swiper-pagination-bullet-active {
        background: #8A826F !important; /* primary-100 from global.css */
        width: 35px !important;
    }
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";

    const swiper = new Swiper(".swiper-container", {
        modules: [Autoplay, Pagination],
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        autoplay: {
            delay: 4000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        breakpoints: {
            640: {
                slidesPerView: 2,
                spaceBetween: 30,
            },
            1024: {
                slidesPerView: 3,
                spaceBetween: 40,
            },
        },
    });
</script>
