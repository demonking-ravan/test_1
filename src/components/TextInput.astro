---
export interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "date" | "number";
  required?: boolean;
  placeholder?: string;
  value?: string;
  class?: string;
  labelClass?: string;
  error?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  required = false,
  placeholder = "",
  value = "",
  class: inputClass = "",
  labelClass = "",
  error = "",
} = Astro.props;
---

<div class="group">
  <label
    for={id}
    class={`block text-2xl lg:text-4xl uppercase tracking-wide mb-2 ${labelClass}`}
  >
    {label}
    {required && <span class="text-red-500">*</span>}
  </label>

  <input
    type={type}
    id={id}
    name={name}
    value={value}
    {required}
    placeholder={placeholder}
    class={`w-full px-4 py-3 text-xl lg:text-2xl border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all ${inputClass} ${error ? "border-red-500" : ""}`}
  />

  {error && <p class="mt-1 text-sm text-red-500">{error}</p>}
</div>
