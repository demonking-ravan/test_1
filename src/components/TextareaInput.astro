---
export interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  value?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  placeholder = "",
  rows = 4,
  required = false,
  value = "",
  class: textareaClass = "",
} = Astro.props;
---

<div class="group">
  <label
    for={id}
    class="block text-2xl lg:text-4xl uppercase tracking-wide text-gray-500 mb-1"
  >
    {label}
    {required && <span class="text-red-500">*</span>}
  </label>

  <textarea
    id={id}
    name={name}
    {rows}
    {placeholder}
    {required}
    class={`w-full px-4 py-3 text-xl lg:text-2xl border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none ${textareaClass}`}
  >
    {value}
  </textarea>
</div>
