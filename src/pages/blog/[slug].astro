---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=31536000');

import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogHero from "../../components/blog/BlogHero.astro";
import { fetchPayload, getMediaUrl } from "../../lib/payload";
import { lexicalToHtml } from "../../lib/lexicalToHtml";

const { slug } = Astro.params;

// Fetch blog post by slug
const response = await fetchPayload<any>("blog", {
    "where[slug][equals]": slug,
    limit: 1,
});

if (!response.docs || response.docs.length === 0) {
    return Astro.redirect("/404");
}

const post = response.docs[0];

const formattedDate = new Date(post.pubDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const contentHtml = lexicalToHtml(post.content);
const tags = post.tags?.map((t: any) => t.tag) || [];
---

<BaseLayout>
    <BlogHero
        tags={tags}
        title={post.title}
        image={getMediaUrl(post.image?.url || post.image)}
        topic={post.topic}
    />

    <section
        class="py-60 px-6 lg:px-16 flex flex-col md:flex-row gap-x-24 gap-y-40"
    >
        <aside class="md:w-[25%] space-y-24">
            <div class="border-t border-black pt-8 space-y-6">
                <p
                    class="font-aventa text-[1rem] uppercase tracking-wider text-gray-700"
                >
                    Topic: <span class="text-brand-beige"
                        >{post.topic}</span
                    >
                </p>
                <div class="space-y-1">
                    <p class="font-aventa text-[1rem] text-gray-700 uppercase">
                        Tags:
                    </p>
                    <p
                        class="font-aventa font-bold text-[1rem] text-brand-beige uppercase"
                    >
                        {tags.join(", ")}
                    </p>
                </div>
            </div>

            <div class="border-t border-black pt-8 space-y-4">
                <p class="font-aventa text-[1rem] text-gray-700 uppercase">
                    Posted
                </p>
                <p
                    class="font-aventa font-bold text-[1rem] text-brand-beige uppercase"
                >
                    {formattedDate}
                </p>
            </div>
        </aside>

        <article
            class="md:w-[65%] font-aventa text-xl leading-relaxed text-[#333] prose-headings:font-orlean prose-h2:text-[1.8rem] prose-h2:md:text-[2.8rem] prose-h2:font-bold prose-h2:tracking-wide prose-h2:mb-6 prose-h3:text-[4rem] prose-h3:font-bold prose-h3:mb-4 prose-p:mb-[4rem] prose-a:underline prose-a:underline-offset-4"
            set:html={contentHtml}
        />
    </section>
</BaseLayout>
