---
import BlogCard from "../components/BlogCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
const blogPosts = await getCollection("blog");
---

<BaseLayout>
    <main class="py-16 md:py-24 px-6 lg:px-16">
        <div class="max-w-560 mx-auto">
            <section class="mb-24">
                <div
                    class="relative w-full h-[50vh] md:h-[65vh] rounded-4xl md:rounded-[4rem] overflow-hidden"
                >
                    <img
                        src="/blogs/blog-main.PNG"
                        alt="Contact Us"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-black/20"></div>

                    <div class="absolute right-0 bottom-0">
                        <div
                            class="bg-white px-8 md:px-12 py-4 md:py-6 rounded-tl-[3rem] md:rounded-tl-[4rem] flex items-center gap-3"
                        >
                            <a
                                href="/"
                                class="font-aventa text-sm md:text-base text-gray-400 hover:text-black transition-colors"
                                >Home</a
                            >
                            <span class="text-gray-300">/</span>
                            <span
                                class="font-aventa text-sm md:text-base text-black font-semibold"
                                >Blogs</span
                            >
                        </div>
                    </div>
                </div>
            </section>

            <header class="mb-32">
                <h1 class="font-orlean sub-heading text-black">Blogs</h1>
            </header>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-16 gap-y-40"
            >
                {
                    blogPosts.map((post) => (
                        <BlogCard
                            description={post.data.description}
                            title={post.data.title}
                            image={post.data.image}
                            url={`/blog/${post.id}`}
                            tags={post.data.tags}
                        />
                    ))
                }
            </div>
        </div>
    </main>
</BaseLayout>
