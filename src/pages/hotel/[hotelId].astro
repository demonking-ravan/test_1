---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=31536000');

import HotelHero from "../../components/hotels/HotelHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchPayload, getMediaUrl } from "../../lib/payload";

const { hotelId } = Astro.params;

let hotel: any;
try {
  hotel = await fetchPayload<any>(`hotels/${hotelId}`);
} catch (e) {
  return Astro.redirect("/404");
}

const locationId = typeof hotel.locationId === 'object' ? hotel.locationId.id : hotel.locationId;
const location = await fetchPayload<any>(`locations/${locationId}`);

const title = `${hotel.name} | Wedding Venue in ${location.name} | Mapsor`;
---

<BaseLayout title={title}>
  <main class="bg-white text-black min-h-screen">
    <HotelHero
      name={hotel.name}
      mainImage={getMediaUrl(hotel.mainImage?.url || hotel.mainImage)}
      locationName={location.name}
      isIndia={location.isIndia}
    />

    <div class="px-6 lg:px-16 py-32">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-32">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-32">
          <!-- Gallery -->
          <section>
            <h2
              class="sec-heading font-bold mb-16 text-black border-b border-gray-100 pb-8"
            >
              Gallery
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {
                hotel.gallery?.map((item: any, i: number) => (
                  <div
                    class={`overflow-hidden rounded-3xl ${i === 0 ? "md:col-span-2 aspect-video" : "aspect-square shadow-sm"}`}
                  >
                    <img
                      src={getMediaUrl(item.image?.url || item.image)}
                      alt={`${hotel.name} gallery ${i + 1}`}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                    />
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Amenities -->
          <section>
            <h2
              class="sec-heading font-bold mb-16 text-black border-b border-gray-100 pb-8"
            >
              Amenities & Services
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
              {
                hotel.amenities?.map((amenityObj: any) => (
                  <div class="flex items-center space-x-3 bg-gray-50 p-6 rounded-2xl border border-gray-100">
                    <span class="w-2 h-2 bg-black rounded-full" />
                    <span class="font-aventa text-[1rem] text-gray-700 font-medium uppercase tracking-wider">
                      {amenityObj.amenity}
                    </span>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Event Spaces -->
          <section>
            <h2
              class="sec-heading font-bold mb-16 text-black border-b border-gray-100 pb-8"
            >
              Event Spaces & Venues
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {
                hotel.eventSpace?.map((space: any) => (
                  <div class="bg-[#fcfcfc] rounded-[2.5rem] overflow-hidden border border-gray-100 group shadow-xs hover:shadow-md transition-all duration-500">
                    {space.image && (
                      <div class="aspect-16/10 overflow-hidden">
                        <img
                          src={getMediaUrl(space.image?.url || space.image)}
                          alt={space.name}
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      </div>
                    )}
                    <div class="p-8 md:p-10">
                      <h3 class="font-aventa text-xl md:text-2xl font-bold text-black mb-4">
                        {space.name || "Main Venue"}
                      </h3>
                      <div class="flex items-center text-gray-500 font-aventa text-sm md:text-base tracking-widest uppercase font-medium">
                        <span class="w-8 h-px bg-brand-beige mr-4" />
                        <span>
                           Capacity: {space.capacity || "Contact for details"}
                        </span>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Room Details -->
          <section>
            <h2
              class="sec-heading font-bold mb-16 text-black border-b border-gray-100 pb-8"
            >
              Accommodation
            </h2>
            <div class="space-y-12">
              {
                hotel.roomDetails?.map((room: any) => (
                  <div class="flex flex-col md:flex-row bg-white rounded-[3rem] overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="md:w-1/3 h-64 md:h-auto overflow-hidden">
                      <img
                        src={getMediaUrl(room.roomImages?.[0]?.image?.url || room.roomImages?.[0]?.image)}
                        alt={room.roomType}
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <div class="md:w-2/3 p-12">
                      <h3 class="footer-heading font-bold text-black mb-6">
                        {room.roomType}
                      </h3>
                      <p class="font-aventa footer-text text-gray-600 leading-relaxed mb-8">
                        {room.description}
                      </p>
                      <div class="flex gap-4">
                        {room.roomImages?.slice(1).map((riObj: any) => (
                          <img
                            src={getMediaUrl(riObj.image?.url || riObj.image)}
                            class="w-20 h-20 rounded-xl object-cover border border-gray-100"
                          />
                        ))}
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>
        </div>

        <!-- Sidebar -->
        <div class="space-y-12">
          <!-- Contact Card -->
          <div
            class="bg-brand-beige text-white p-12 rounded-[3.5rem] sticky top-32 shadow-xl"
          >
            <h3
              class="sec-heading font-bold mb-10 border-b border-white/10 pb-6"
            >
              Reservations
            </h3>
            <div class="space-y-10">
              <div>
                <p
                  class="font-aventa text-[1.2rem] uppercase tracking-widest text-gray-800 font-bold mb-2"
                >
                  Address
                </p>
                <p class="font-aventa footer-text leading-snug">
                  {hotel.contact?.address}
                </p>
              </div>
              <div>
                <p
                  class="font-aventa text-[1.2rem] uppercase tracking-widest text-gray-800 font-bold mb-2"
                >
                  Phone
                </p>
                <p
                  class="font-aventa font-bold footer-text wrap-break-word tracking-wider"
                >
                  <a href={`tel:+${hotel.contact?.phone}`}
                    >{hotel.contact?.phone}</a
                  >
                </p>
              </div>
              <div>
                <p
                  class="font-aventa text-[1.2rem] uppercase tracking-widest text-gray-800 font-bold mb-2"
                >
                  Email
                </p>
                <p class="font-aventa footer-text wrap-break-word">
                  {hotel.contact?.email}
                </p>
              </div>
              <a href="/contact" class="btn-primary hover:bg-brand-grey!">
                Enquire Now
              </a>
            </div>

            <!-- Nearby Places -->
            <div class="mt-16 pt-12 border-t border-white/10">
              <h4 class="sec-heading font-bold mb-8">Nearby Attractions</h4>
              <ul class="space-y-6">
                {
                  hotel.nearbyPlaces?.map((place: any) => (
                    <li class="flex justify-between items-center footer-text">
                      <span class="font-aventa font-semibold tracking-wide text-gray-800">
                        {place.name}
                      </span>
                      <span class="font-aventa text-gray-800 px-4 py-1.5 bg-brand-grey rounded-full border border-white/5">
                        {place.distance}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
