<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<style is:global>
    .home-swiper .swiper-pagination-bullet {
        width: 12px !important;
        height: 12px !important;
        background: #fff !important;
        opacity: 0.5 !important;
        transition: all 0.5s ease !important;
        border-radius: 99px !important;
    }
    .home-swiper .swiper-pagination-bullet-active {
        background: #fff !important;
        opacity: 1 !important;
        width: 40px !important;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";

    gsap.registerPlugin(ScrollTrigger);

    // Initialize Home Swiper
    new Swiper(".home-swiper", {
        modules: [Autoplay, Pagination],
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
    });

    const track = document.querySelector("#horizontal-track") as HTMLElement;
    const viewport = document.querySelector(
        "#horizontal-viewport",
    ) as HTMLElement;

    if (track && viewport) {
        gsap.to(track, {
            x: () => -(track.scrollWidth - window.innerWidth),
            ease: "none",
            scrollTrigger: {
                trigger: viewport, // Only pin the specific wrapper
                pin: true,
                scrub: 1,
                start: "top top", // Starts pinning when the section hits the top of the screen
                end: () => `+=${track.scrollWidth}`, // Pins for the duration of the track's width
                invalidateOnRefresh: true,
            },
        });
    }

    // Video Autoplay Performance & Sound Control
    const video = document.querySelector("#hero-video") as HTMLVideoElement;
    const muteToggle = document.querySelector(
        "#mute-toggle",
    ) as HTMLButtonElement;
    const muteIcon = document.querySelector("#mute-icon") as HTMLElement;

    if (video) {
        if (muteToggle && muteIcon) {
            muteToggle.addEventListener("click", () => {
                if (video.muted) {
                    video.muted = false;
                    muteIcon.classList.remove("fa-volume-xmark");
                    muteIcon.classList.add("fa-volume-up");
                } else {
                    video.muted = true;
                    muteIcon.classList.remove("fa-volume-up");
                    muteIcon.classList.add("fa-volume-xmark");
                }
            });
        }

        // Only attempt to play when visible, pause when hidden to save CPU
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        video.play().catch(() => {
                            // Suppress errors about autoplay blocking
                        });
                    } else {
                        video.pause();
                    }
                });
            },
            { threshold: 0.1 },
        );
        observer.observe(video);
    }
</script>
