---
import BaseLayout from "../layouts/BaseLayout.astro";

const destinations = {
    id: "01",
    title: "Destination Management",
    subtitle: "(International & National)",
    description:
        "At Mapsor Experiential Weddings, we specialize in crafting extraordinary destination weddings across India and around the globe—each one thoughtfully designed to reflect your unique story, style, and vision. From serene beachfront ceremonies to regal palace celebrations and scenic mountain escapes, we curate destinations that perfectly align with the ambiance you envision.",
    description2:
        "Our destination management services go far beyond selection—we handle every detail with precision and expertise. This includes venue scouting, vendor coordination, guest logistics, travel planning, accommodation management, and on-ground execution. Whether you're dreaming of an intimate getaway wedding or a grand multi-day celebration, our team ensures a stress-free experience for you and your guests.",
    image: "https://images.unsplash.com/photo-1519225497282-c4892437691d?auto=format&fit=crop&q=80&w=1200",
    subServices: [
        {
            title: "Hotel Coordination & Management",
            desc: "The right hotel is the heart of your wedding experience. We guide you toward the perfect property—from heritage palaces to boutique resorts—managing contracts, room blocks, and hospitality desks for a seamless stay.",
        },
        {
            title: "Logistics Coordination & Management",
            desc: "Flawless celebrations are built on seamless movement. We orchestrate all transportation—airport transfers, venue shuttles, and VIP logistics—ensuring every guest's journey is smooth and on time.",
        },
        {
            title: "RSVP & Guest Management",
            desc: "We believe in a guest-centric approach. From invitation tracking and distribution to curating personalized destination itineraries and managing room allocations, we ensure your guests feel truly valued.",
        },
    ],
};

const hospitality = {
    id: "02",
    title: "Hospitality & Guest Management",
    description:
        "A truly memorable wedding is defined by the experience of every guest. Our hospitality services are designed to create a warm, thoughtfully curated journey from arrival to departure. Through well-structured communication and personalized assistance, we make certain that each guest is fully informed and comfortable.",
    image: "https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&q=80&w=1200",
    agencies: [
        {
            title: "Decor Designer Coordination",
            desc: "We collaborate with leading designers to transform your style into a cohesive visual soul—managing concept development, budgets, and technical execution for a breathtaking experience.",
        },
        {
            title: "Food Designing & Catering",
            desc: "We treat food as a sensory experience. From assisting in partner selection to designing live counters and innovative presentations, we ensure every dish complements your wedding theme.",
        },
        {
            title: "Entertainment Designing",
            desc: "The heartbeat of the celebration. We curate a diverse lineup—from live bands to bespoke acts—strategically managing technicals and stage flow to create an electrifying atmosphere.",
        },
        {
            title: "Room Hamper & Amenities",
            desc: "Setting the tone with thoughtful first impressions. We curate bespoke welcome hampers and coordinate in-room amenities that offer your guests a heartfelt, personalized welcome.",
        },
        {
            title: "Photo & Video Coordination",
            desc: "Your love story captured with artistry. We connect you with the perfect creative professionals, aligning on shot lists and mood boards to ensure your memories are documented with finesse.",
        },
        {
            title: "Choreography Agency",
            desc: "Expressions of joy brought to life. We select the right choreographers and manage rehearsal timelines across different functions, ensuring every performance leaves your guests truly captivated.",
        },
        {
            title: "Makeup Artist Coordination",
            desc: "Your bridal beauty journey, carefully curated. We recommend the most suitable artists for your style, organizing trials and managing schedules so you feel radiant and confident.",
        },
    ],
};
---

<BaseLayout title="Services | Mapsor Experiential Weddings">
    <main class="bg-white">
        <!-- Hero Section -->
        <section class="pt-32 pb-16 px-6 md:px-24">
            <div class="mb-16 space-y-4">
                <p
                    class="font-orlean text-[1rem] uppercase tracking-[0.3rem] text-primary-100"
                >
                    Our Expertise
                </p>
                <h1 class="sub-heading text-black">
                    Our <span class="text-gray-300">Services</span>
                </h1>
            </div>

            <div
                class="relative w-full h-[50vh] md:h-[70vh] rounded-[3rem] overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80&w=2000"
                    alt="Bespoke Services"
                    class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 scale-105 group-hover:scale-100"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"
                >
                </div>
                <div
                    class="absolute bottom-12 left-12 md:left-20 max-w-2xl px-6"
                >
                    <p
                        class="font-aventa text-white text-xl md:text-2xl leading-relaxed"
                    >
                        We integrate imagination, cultural understanding, and
                        sophisticated execution to turn dreams into reality.
                    </p>
                </div>
            </div>
        </section>

        <!-- Section 1: Destination Management -->
        <section class="py-24 md:py-32 space-y-24" id="destination-management">
            <div class="px-6 md:px-24">
                <div
                    class="flex flex-col md:flex-row gap-16 md:gap-32 items-center"
                >
                    <div class="w-full md:w-1/2 space-y-10 reveal-up">
                        <div class="space-y-4">
                            <span
                                class="font-orlean text-6xl text-gray-100 leading-none"
                            >
                                {destinations.id}
                            </span>
                            <h2 class="sub-heading leading-tight">
                                {destinations.title}
                                <br />
                                <span class="text-gray-300 text-3xl md:text-5xl"
                                    >{destinations.subtitle}</span
                                >
                            </h2>
                        </div>
                        <p
                            class="font-aventa text-lg md:text-xl text-gray-500 leading-relaxed text-justify"
                        >
                            {destinations.description}
                        </p>
                        <p
                            class="font-aventa text-lg md:text-xl text-gray-500 leading-relaxed text-justify"
                        >
                            {destinations.description2}
                        </p>
                    </div>
                    <div
                        class="w-full md:w-1/2 aspect-4/5 overflow-hidden rounded-[3rem] shadow-2xl reveal-up"
                    >
                        <img
                            src={destinations.image}
                            alt={destinations.title}
                            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 scale-110 hover:scale-100"
                        />
                    </div>
                </div>
            </div>

            <div class="px-6 md:px-24 grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    destinations.subServices.map((service) => (
                        <div class="bg-gray-50 p-10 rounded-[2.5rem] hover:bg-primary-100 group transition-all duration-700 reveal-up">
                            <h3 class="font-orlean text-2xl uppercase text-black mb-6 group-hover:text-white transition-colors">
                                {service.title}
                            </h3>
                            <p class="font-aventa text-gray-500 group-hover:text-white/80 transition-colors">
                                {service.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Section 2: Hospitality & Guest Management -->
        <section
            class="bg-[#101820] py-32 md:py-48 px-6 md:px-24 relative overflow-hidden"
            id="hospitality-guest-management"
        >
            <!-- Decorative circles -->
            <div
                class="absolute top-0 right-0 w-96 h-96 bg-primary-100/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-0 left-0 w-96 h-96 bg-primary-100/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl"
            >
            </div>

            <div class="max-w-[1440px] mx-auto relative z-10">
                <div
                    class="flex flex-col md:flex-row-reverse gap-16 md:gap-32 items-center mb-32"
                >
                    <div class="w-full md:w-1/2 space-y-10 reveal-up">
                        <div class="space-y-4">
                            <span
                                class="font-orlean text-6xl text-white/5 leading-none"
                            >
                                {hospitality.id}
                            </span>
                            <h2 class="sub-heading text-white leading-tight">
                                {hospitality.title}
                            </h2>
                        </div>
                        <p
                            class="font-aventa text-lg md:text-xl text-gray-400 leading-relaxed text-justify"
                        >
                            {hospitality.description}
                        </p>
                    </div>
                    <div
                        class="w-full md:w-1/2 aspect-4/5 overflow-hidden rounded-[3rem] border border-white/10 reveal-up"
                    >
                        <img
                            src={hospitality.image}
                            alt={hospitality.title}
                            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 scale-110 hover:scale-100"
                        />
                    </div>
                </div>

                <div class="text-center mb-20">
                    <p
                        class="font-orlean text-primary-100 uppercase tracking-widest text-lg font-bold"
                    >
                        Coordination & Management
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    {
                        hospitality.agencies.map((agency) => (
                            <div class="bg-white/5 border border-white/10 p-10 rounded-[2.5rem] hover:bg-white/10 hover:border-primary-100 transition-all duration-700 group reveal-up">
                                <h4 class="font-orlean text-2xl uppercase text-white mb-6 group-hover:text-primary-100 transition-colors">
                                    {agency.title}
                                </h4>
                                <p class="font-aventa text-base text-gray-400 leading-relaxed group-hover:text-gray-300 transition-colors">
                                    {agency.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-32 md:py-48 px-6 md:px-24 text-center">
            <div class="max-w-4xl mx-auto space-y-12">
                <p
                    class="font-orlean text-[1rem] uppercase tracking-[0.3rem] text-gray-400"
                >
                    Your journey begins here
                </p>
                <div class="group inline-block">
                    <a href="/contact" class="block">
                        <h2
                            class="font-orlean text-5xl md:text-8xl uppercase text-black leading-none group-hover:text-primary-100 transition-colors duration-700"
                        >
                            Plan Your <span class="text-gray-200">Story</span>
                        </h2>
                        <div
                            class="h-1 w-0 bg-primary-100 mx-auto mt-4 transition-all duration-700 group-hover:w-full opacity-50"
                        >
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Scroll Animations
    gsap.utils.toArray(".reveal-up").forEach((el: any) => {
        gsap.from(el, {
            scrollTrigger: {
                trigger: el,
                start: "top 85%",
            },
            y: 50,
            opacity: 0,
            duration: 1,
            ease: "power3.out",
        });
    });
</script>
