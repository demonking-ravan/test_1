---
import BaseLayout from "../layouts/BaseLayout.astro";
import { servicesData } from "../data/servicesData";
---

<BaseLayout title="Services | Mapsor Experiential Weddings">
    <main class="bg-white">
        <!-- Hero Section -->
        <section class="pt-32 pb-16 px-6 md:px-24">
            <div class="mb-16 space-y-4">
                <p class="sec-tagline">Our Expertise</p>
                <h1 class="sub-heading text-black">
                    Our <span class="text-brand-beige">Services</span>
                </h1>
            </div>

            <div
                class="relative w-full h-[50vh] md:h-[70vh] rounded-[3rem] overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80&w=2000"
                    alt="Bespoke Services"
                    class="w-full h-full object-cover transition-all duration-1000 scale-105 group-hover:scale-100"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"
                >
                </div>
                <div
                    class="absolute bottom-12 left-12 md:left-20 max-w-2xl px-6"
                >
                    <p
                        class="font-aventa text-white text-xl md:text-2xl leading-relaxed"
                    >
                        We integrate imagination, cultural understanding, and
                        sophisticated execution to turn dreams into reality.
                    </p>
                </div>
            </div>
        </section>

        <!-- Services Loop -->
        {
            servicesData.map((service, index) => {
                const isEven = index % 2 !== 0;
                return (
                    <section
                        class={`py-24 md:py-32 relative overflow-hidden ${isEven ? "bg-brand-grey" : ""}`}
                        id={`service-${index}`}
                    >
                        {isEven && (
                            <>
                                <div class="absolute top-0 right-0 w-96 h-96 bg-primary-100/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl" />
                                <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-100/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl" />
                            </>
                        )}
                        <div class="px-6 md:px-24 mx-auto relative z-10">
                            <div
                                class={`flex flex-col ${isEven ? "md:flex-row-reverse" : "md:flex-row"} gap-16 md:gap-32 items-center`}
                            >
                                <div class="w-full md:w-1/2 space-y-10 reveal-up">
                                    <div class="space-y-4">
                                        <span
                                            class={`font-orlean text-6xl leading-none ${isEven ? "text-brand-beige" : "text-brand-beige"}`}
                                        >
                                            {service.id}
                                        </span>
                                        <h2
                                            class={`sub-heading leading-tight ${isEven ? "" : ""}`}
                                        >
                                            {service.title}
                                            {service.subtitle && (
                                                <>
                                                    <br />
                                                    <span
                                                        class={` ${isEven ? "text-brand-beige" : "text-brand-beige"}`}
                                                    >
                                                        {service.subtitle}
                                                    </span>
                                                </>
                                            )}
                                        </h2>
                                    </div>
                                    <div class="space-y-4 text-justify">
                                        {service.description.map((p) => (
                                            <p
                                                class={`font-aventa textS leading-relaxed ${isEven ? "text-gray-400" : ""}`}
                                            >
                                                {p}
                                            </p>
                                        ))}
                                    </div>
                                </div>
                                <div
                                    class={`w-full md:w-1/2 aspect-4/5 overflow-hidden rounded-[3rem] reveal-up ${isEven ? "border border-white/10" : "shadow-2xl"}`}
                                >
                                    <img
                                        src={service.image}
                                        alt={service.title}
                                        class="w-full h-full object-cover transition-all duration-1000 scale-110 hover:scale-100"
                                    />
                                </div>
                            </div>
                        </div>
                    </section>
                );
            })
        }

        <!-- Final CTA -->
        <section class="py-32 md:py-48 px-6 md:px-24 text-center">
            <div class="max-w-4xl mx-auto space-y-12">
                <p
                    class="font-orlean text-[1rem] uppercase tracking-[0.3rem] text-gray-400"
                >
                    Your journey begins here
                </p>
                <div class="group inline-block">
                    <a href="/contact" class="block">
                        <h2
                            class="font-orlean text-5xl md:text-8xl uppercase text-black leading-none group-hover:text-brand-beige transition-colors duration-700"
                        >
                            Plan Your <span class="text-gray-200">Story</span>
                        </h2>
                        <div
                            class="h-1 w-0 bg-brand-beige mx-auto mt-4 transition-all duration-700 group-hover:w-full opacity-50"
                        >
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Scroll Animations
    gsap.utils.toArray(".reveal-up").forEach((el: any) => {
        gsap.from(el, {
            scrollTrigger: {
                trigger: el,
                start: "top 85%",
            },
            y: 50,
            opacity: 0,
            duration: 1,
            ease: "power3.out",
        });
    });
</script>
