---
import VenueCard from "../components/VenueCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const indiaLocations = await getCollection("locations", ({ data }) => {
  return data.isIndia === true;
});

const title =
  "Exquisite Wedding Venues in India | Mapsor Experiential Weddings";
const description =
  "Discover the most stunning and luxurious wedding venues across India, curated for your dream celebration.";
---

<BaseLayout title={title} description={description}>
  <main class="py-48 px-6 md:px-24 bg-white">
    <div class="max-w-560 mx-auto">
      <header class="mb-32">
        <h1 class="sub-heading text-black">
          Venues in <span class="text-gray-300">India</span>
        </h1>
        <p class="textM max-w-240 mt-8">
          From the royal palaces of Rajasthan to the serene beaches of Goa,
          discover our handpicked collection of India's most prestigious wedding
          destinations.
        </p>
        <!-- <p class="font-aventa text-[1.8rem] text-gray-600 mt-4 max-w-2xl">
          From the royal palaces of Rajasthan to the serene beaches of Goa,
          discover our handpicked collection of India's most prestigious wedding
          destinations.
        </p> -->
      </header>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-16 gap-y-40"
      >
        {
          indiaLocations.map((location) => (
            <VenueCard
              name={location.data.name}
              featuredImage={location.data.featuredImage}
              hotelCount={location.data.hotelCount}
              url={`/venues/${location.id}`}
            />
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
