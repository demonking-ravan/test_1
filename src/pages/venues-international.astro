---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=31536000');

import VenueCard from "../components/VenueCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchPayload, getMediaUrl } from "../lib/payload";

const response = await fetchPayload<any>("locations", {
  "where[isIndia][equals]": "false",
  limit: 100,
});
const internationalLocations = response.docs || [];

const title =
  "Luxury International Wedding Destinations | Mapsor Experiential Weddings";
const description =
  "Explore breathtaking international wedding venues across the globe, from European villas to tropical islands.";
---

<BaseLayout title={title} description={description}>
  <main class="py-16 md:py-24 px-6 md:px-24 bg-white">
    <div class="max-w-560 mx-auto">
      <section class="mb-24">
        <div
          class="relative w-full h-[50vh] md:h-[65vh] rounded-4xl md:rounded-[4rem] overflow-hidden"
        >
          <img
            src="/venue/venue-out.jpg"
            alt="Contact Us"
            class="absolute inset-0 w-full h-full object-cover object-top"
          />
          <div class="absolute inset-0 bg-black/20"></div>

          <div class="absolute right-0 bottom-0">
            <div
              class="bg-white px-8 md:px-12 py-4 md:py-6 rounded-tl-[3rem] md:rounded-tl-[4rem] flex items-center gap-3"
            >
              <a
                href="/"
                class="font-aventa text-sm md:text-base text-gray-400 hover:text-black transition-colors"
                >Home</a
              >
              <span class="text-gray-300">/</span>
              <span
                class="font-aventa text-sm md:text-base text-black font-semibold"
                >Venue International</span
              >
            </div>
          </div>
        </div>
      </section>

      <header class="mb-24">
        <h1 class="sub-heading text-black">
          International <span class="text-brand-beige">Venues</span>
        </h1>
        <p class="textM max-w-240 mt-8">
          Embark on a global journey to find the perfect destination for your
          dream international wedding.
        </p>
      </header>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-16 gap-y-40"
      >
        {
          internationalLocations.length > 0 ? (
            internationalLocations.map((location: any) => (
              <VenueCard
                name={location.name}
                featuredImage={getMediaUrl(location.featuredImage?.url || location.featuredImage)}
                hotelCount={location.hotelCount}
                url={`/venues/${location.id}`}
              />
            ))
          ) : (
            <div class="col-span-full py-20 text-center">
              <p class="font-aventa text-gray-500 text-[2.2rem] italic">
                More international destinations coming soon...
              </p>
            </div>
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>
