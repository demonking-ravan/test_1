---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=31536000');

import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchPayload, getMediaUrl } from "../../lib/payload";

const { slug } = Astro.params;

const response = await fetchPayload<any>("work", {
    "where[slug][equals]": slug,
    limit: 1,
    depth: 1,
});

if (!response.docs || response.docs.length === 0) {
    return Astro.redirect("/404");
}

const project = response.docs[0];
const { title, image, gallery, nextProject } = project;
const mainImage = getMediaUrl(image?.url || image);
const nextProjectSlug = nextProject?.slug || nextProject?.id;
---

<BaseLayout title={`${title} | Mapsor Experiential Weddings`}>
    <main
        class="h-screen overflow-hidden bg-white select-none relative"
        id="main-viewport"
    >
        <div class="flex flex-nowrap h-full w-fit" id="horizontal-track">
            <!-- Hero Section -->
            <section class="flex-none sm:w-screen h-full flex">
                <div
                    class="w-[70vw] sm:w-[40%] h-full flex flex-col justify-center px-10 lg:px-30 space-y-[4rem]"
                >
                    <div class="space-y-12">
                        <a 
                            href="/works" 
                            class="inline-flex items-center gap-4 group/back font-aventa text-sm uppercase tracking-widest text-gray-500 hover:text-brand-beige transition-colors"
                        >
                            <span class="transform transition-transform group-hover/back:-translate-x-2">←</span>
                            Back to Work
                        </a>
                        <h1
                            class="sub-heading leading-[0.9] text-black tracking-tight"
                            set:html={title.replace(" & ", " &<br />")}
                        />
                    </div>
                </div>

                <div class="w-screen sm:w-[60%] h-full pl-16">
                    <img
                        src={mainImage}
                        alt={title}
                        class="w-full h-full object-cover"
                    />
                </div>
            </section>

            <!-- Gallery Section -->
            {gallery && gallery.length > 0 && (
                <section
                    class="flex-none w-fit h-full flex items-center px-16 gap-16"
                >
                    {gallery.map((imgObj: any) => {
                        const imgUrl = getMediaUrl(imgObj.image?.url || imgObj.image);
                        return (
                        <div class="h-[80vh] w-[80vw] sm:w-[40vw] overflow-hidden">
                            <img
                                src={imgUrl}
                                alt={title}
                                class="w-full h-full object-cover shadow-sm transition-all duration-1000 scale-110 hover:scale-100"
                            />
                        </div>
                    )})}
                </section>
            )}

            <!-- Next Project Section -->
            {nextProject && (
                <section class="flex-none sm:w-screen h-full flex gap-16 pr-16">
                    <div
                        class="w-screen sm:w-[50%] h-full transition-all duration-1000 ease-in-out overflow-hidden"
                    >
                        <img
                            src={mainImage} 
                            class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
                        />
                    </div>

                    <div
                        class="w-[80vw] sm:w-[50%] h-full flex flex-col items-center justify-center"
                    >
                        <a href={`/work/${nextProjectSlug}`} class="group cursor-pointer text-center">
                            <p
                                class="font-orlean text-[1.8rem] uppercase tracking-[0.3rem] mb-8 text-gray-500"
                            >
                                {nextProject.title || 'Next'}
                            </p>
                            <div class="relative inline-block">
                                <h2
                                    class="sub-heading leading-none uppercase text-black"
                                >
                                    Next Project
                                </h2>
                                <div
                                    class="absolute -bottom-4 left-0 w-full h-px bg-black origin-left transform transition-transform duration-700 scale-x-100 group-hover:scale-x-0"
                                >
                                </div>
                                <div
                                    class="absolute -bottom-4 left-0 w-full h-px bg-black origin-right transform scale-x-0 transition-transform duration-700 group-hover:scale-x-100"
                                >
                                </div>
                            </div>
                        </a>
                    </div>
                </section>
            )}
        </div>
    </main>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const track = document.querySelector(
            "#horizontal-track",
        ) as HTMLElement;
        const mainViewport = document.querySelector(
            "#main-viewport",
        ) as HTMLElement;

        if (track && mainViewport) {
            gsap.to(track, {
                x: () => -(track.scrollWidth - window.innerWidth),
                ease: "none",
                scrollTrigger: {
                    trigger: mainViewport,
                    pin: true,
                    scrub: 1,
                    invalidateOnRefresh: true,
                    // end: () => `+=${track.scrollWidth - window.innerWidth}`,
                    end: () => `+=${track.scrollWidth}`,
                },
            });

            // Refresh ScrollTrigger to ensure alignment with Lenis
            ScrollTrigger.refresh();
        }
    </script>
</BaseLayout>
