---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("work");
---

<BaseLayout title="Our Work | Mapsor Experiential Weddings">
    <main class="py-48 px-6 md:px-24 bg-white">
        <div class="max-w-560 mx-auto">
            <header class="mb-32">
                <h1 class="sub-heading text-black">
                    Our <span class="text-gray-300">Work</span>
                </h1>
                <p class="textM max-w-240 mt-8">
                    A curated selection of weddings we've had the honor of
                    planning and capturing across the globe.
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-32">
                {
                    projects.map((project) => (
                        <a
                            href={`/work/${project.id}`}
                            class="group cursor-pointer space-y-8"
                        >
                            <div class="aspect-video overflow-hidden">
                                <img
                                    src={project.data.image}
                                    alt={project.data.title}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                />
                            </div>
                            <div class="space-y-2">
                                <p class="font-aventa text-[1rem] uppercase tracking-widest text-gray-500">
                                    {project.data.location}
                                </p>
                                <h2 class="sec-heading text-black group-hover:underline decoration-1 underline-offset-8">
                                    {project.data.title}
                                </h2>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </main>
</BaseLayout>
